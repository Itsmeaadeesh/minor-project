# =============================================================================
# Skill Setu - Client Environment Configuration (.env)
# =============================================================================

# Backend Express API URL
# For local development with Vite proxy, use: http://localhost:5000/api
# For production (Vercel deployment), point to your Render/Railway backend URL:
# VITE_API_URL=https://skill-setu-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Supabase Auth & Storage Configuration
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...[YOUR-SUPABASE-ANON-KEY]
