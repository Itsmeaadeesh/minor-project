# =============================================================================
# Skill Setu - Server Environment Configuration (.env)
# =============================================================================

# Server Port
PORT=5000

# Client Application URL (for CORS verification)
# For local dev: http://localhost:5173
# For production: https://skill-setu.vercel.app
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase Postgres)
# Retrieve from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format for Direct connection: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Format for Local SQLite testing fallback: file:./dev.db
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JSON Web Token Secret (used for signing session tokens and fallback auth)
JWT_SECRET=skill_setu_production_super_secret_jwt_key_2026_secure

# Google Gemini API Configuration (used for AI quiz generation from uploaded PDF/PPT)
# Obtain a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...[YOUR-GEMINI-API-KEY]
GEMINI_MODEL=gemini-1.5-flash

# Supabase Auth & Storage API Keys
# Retrieve from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJh...[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=eyJh...[YOUR-SUPABASE-SERVICE-ROLE-KEY]
