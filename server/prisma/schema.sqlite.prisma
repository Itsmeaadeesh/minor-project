datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(uuid())
  supabaseUid     String?        @unique @map("supabase_uid")
  email           String         @unique
  password        String?
  name            String
  role            String         @default("LEARNER") // LEARNER or ADMIN
  avatar          String?
  targetTrackId   String?        @map("target_track_id")
  targetTrack     Track?         @relation(fields: [targetTrackId], references: [id], onDelete: SetNull)
  hasOnboarded    Boolean        @default(false) @map("has_onboarded")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  skillLevels     LearnerSkillLevel[]
  quizAttempts    QuizAttempt[]
  learningPaths   LearningPath[]
  uploads         Upload[]
  quizzesCreated  Quiz[]         @relation("QuizzesCreated")
  activityLogs    ActivityLog[]  @relation("ActorActivity")

  @@map("users")
}

model Track {
  id              String             @id @default(uuid())
  name            String             @unique
  slug            String             @unique
  description     String
  icon            String             @default("Compass")
  color           String             @default("indigo")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  users           User[]
  trackSkills     TrackSkill[]
  courses         Course[]
  quizzes         Quiz[]

  @@map("tracks")
}

model Skill {
  id              String             @id @default(uuid())
  name            String             @unique
  slug            String             @unique
  category        String             // Frontend, Backend, Data, Cloud, CS, Security
  description     String?
  icon            String             @default("Zap")
  createdAt       DateTime           @default(now()) @map("created_at")

  trackSkills     TrackSkill[]
  learnerLevels   LearnerSkillLevel[]
  courses         Course[]
  quizzes         Quiz[]

  @@map("skills")
}

model TrackSkill {
  id                          String   @id @default(uuid())
  trackId                     String   @map("track_id")
  skillId                     String   @map("skill_id")
  requiredProficiencyLevel    Int      @default(3) @map("required_proficiency_level") // 1 to 5 scale

  track                       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  skill                       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([trackId, skillId])
  @@map("track_skills")
}

model LearnerSkillLevel {
  id             String   @id @default(uuid())
  learnerId      String   @map("learner_id")
  skillId        String   @map("skill_id")
  currentLevel   Int      @default(1) @map("current_level") // 1 to 5 scale
  source         String   @default("self-rated") // "quiz", "self-rated", "assessment"
  lastUpdated    DateTime @default(now()) @updatedAt @map("last_updated")

  learner        User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  skill          Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([learnerId, skillId])
  @@map("learner_skill_levels")
}

model Course {
  id                     String           @id @default(uuid())
  title                  String
  description            String
  sourceLink             String?          @map("source_link")
  taggedSkillId          String           @map("tagged_skill_id")
  trackId                String?          @map("track_id")
  difficultyLevel        String           @default("FOUNDATIONAL") @map("difficulty_level")
  durationHours          Int              @default(10) @map("duration_hours")
  provider               String           @default("Skill Setu Academy")
  rating                 Float            @default(4.8)
  thumbnail              String?
  prerequisiteCourseId   String?          @map("prerequisite_course_id")
  createdAt              DateTime         @default(now()) @map("created_at")

  taggedSkill            Skill            @relation(fields: [taggedSkillId], references: [id], onDelete: Cascade)
  track                  Track?           @relation(fields: [trackId], references: [id], onDelete: SetNull)
  prerequisiteCourse     Course?          @relation("CoursePrerequisites", fields: [prerequisiteCourseId], references: [id], onDelete: SetNull)
  dependentCourses       Course[]         @relation("CoursePrerequisites")

  @@map("courses")
}

model LearningPath {
  id              String   @id @default(uuid())
  learnerId       String   @map("learner_id")
  orderedSequence String   @map("ordered_sequence") // JSON string of ordered courses, milestones, prerequisite graph
  generatedAt     DateTime @default(now()) @map("generated_at")

  learner         User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@map("learning_paths")
}

model Upload {
  id              String   @id @default(uuid())
  learnerId       String   @map("learner_id")
  fileUrl         String   @map("file_url")
  fileName        String   @map("file_name")
  fileType        String   @map("file_type") // pdf, ppt, pptx, docx, txt
  fileSize        Int      @default(0) @map("file_size")
  extractedText   String   @map("extracted_text")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  learner         User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  quizzes         Quiz[]

  @@map("uploads")
}

model Quiz {
  id                String         @id @default(uuid())
  uploadId          String?        @map("upload_id")
  generatedFrom     String?        @map("generated_from") // "upload", "baseline", "ai-topic"
  title             String
  description       String?
  trackId           String?        @map("track_id")
  skillId           String?        @map("skill_id")
  isBaseline        Boolean        @default(false) @map("is_baseline")
  createdById       String?        @map("created_by_id")
  timeLimitMinutes  Int            @default(15) @map("time_limit_minutes")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  upload            Upload?        @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  track             Track?         @relation(fields: [trackId], references: [id], onDelete: SetNull)
  skill             Skill?         @relation(fields: [skillId], references: [id], onDelete: SetNull)
  createdBy         User?          @relation("QuizzesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  questions         QuizQuestion[]
  attempts          QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id             String   @id @default(uuid())
  quizId         String   @map("quiz_id")
  questionText   String   @map("question_text")
  options        String   // JSON string of string[4]
  correctAnswer  Int      @default(0) @map("correct_answer") // 0, 1, 2, or 3
  explanation    String
  difficulty     String   @default("intermediate") // "foundational", "intermediate", "advanced"
  createdAt      DateTime @default(now()) @map("created_at")

  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id             String   @id @default(uuid())
  learnerId      String   @map("learner_id")
  quizId         String   @map("quiz_id")
  score          Int      @default(0)
  totalQuestions Int      @default(0) @map("total_questions")
  percentage     Float    @default(0.0)
  passed         Boolean  @default(false)
  answers        String   @map("answers") // JSON string of selected answers & question results
  attemptedAt    DateTime @default(now()) @map("attempted_at")

  learner        User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  actionType  String   @map("action_type") // e.g. "AUTH_LOGIN", "ASSESSMENT_SUBMITTED", "QUIZ_ATTEMPT", "QUIZ_GENERATED", "RECOMMENDATION_RECALCULATED", "UPLOAD_PROCESSED", "SCORE_CHANGED"
  metadata    String   @default("{}") // JSON string of action metadata
  timestamp   DateTime @default(now())

  actor       User?    @relation("ActorActivity", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actionType])
  @@index([timestamp])
  @@index([actorId])
  @@map("activity_logs")
}
